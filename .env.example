# Supabase project settings — Dashboard > Project Settings > API
# Public values (safe in the browser; data is protected by row-level security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit the real value.
# Used by API routes to write submissions, signatures and PDFs after auth checks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
